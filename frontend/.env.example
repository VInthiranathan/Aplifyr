# Backend API URL (server-side only - not exposed to browser)
BACKEND_URL=http://localhost:5000

# Backend API URL (exposed to browser)
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Optional: expose debug API panels outside development
NEXT_PUBLIC_ENABLE_DEBUG_UI=false

# Supabase Configuration (for frontend auth)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
