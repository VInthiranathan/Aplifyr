# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: comma-separated allowed frontend origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI API Keys for Cover Letter Generation
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Public anon/publishable key for server-side validation of user access tokens.
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Enable ONLY providers whose contracts, retention and transfers have been reviewed.
# Empty disables AI. Examples: gemini / groq / gemini,groq (permits fallback).
AI_ALLOWED_PROVIDERS=
# Select an available model in your Gemini account; no retired hardcoded default.
GEMINI_MODEL=
