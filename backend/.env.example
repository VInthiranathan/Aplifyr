# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: comma-separated allowed frontend origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI API Keys for Cover Letter Generation
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Public anon/publishable key for server-side validation of user access tokens.
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Enable ONLY providers whose contracts, retention and transfers have been reviewed.
# Empty disables AI. Examples: gemini / groq / gemini,groq (permits fallback).
AI_ALLOWED_PROVIDERS=
# AI now also requires migration 008 and SUPABASE_SERVICE_ROLE_KEY (server only)
# for atomic consent/usage reservations. Provider notices start disabled in the DB.
# Select an available model in your Gemini account; no retired hardcoded default.
GEMINI_MODEL=

# CV only. Never falls back to GEMINI_API_KEY. Server-side backend configuration.
GEMINI_CV_API_KEY=
# Exact reviewed Gemini notice version covering CV processing and full career facts.
# Must match the active notice and the user's consent; do not reuse a letter-only notice.
GEMINI_CV_NOTICE_VERSION=
